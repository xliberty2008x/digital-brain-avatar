# Local development only. Compose publishes Neo4j/MCP/Ollama on 127.0.0.1.
# Change NEO4J_PASSWORD before any shared-machine use. See SECURITY.md.
DIGITAL_BRAIN_MCP_URL=http://localhost:8000/api/mcp/

NEO4J_URI=bolt://localhost:7687
# Admin / bootstrap only (scripts/init_quality_roles.py, migrations).
# Do not mount admin credentials into analyzer/evaluator or model tool envs.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_ADMIN_USERNAME=neo4j
NEO4J_ADMIN_PASSWORD=password
NEO4J_DATABASE=neo4j

# Model-facing runtime role (life-graph MATCH/WRITE; DENY Operational/control).
# Create with: uv run --group dev python scripts/init_quality_roles.py --apply
NEO4J_RUNTIME_USERNAME=digital_brain_runtime
NEO4J_RUNTIME_PASSWORD=change-me-runtime

# Typed quality/control transactions (Operational OK). Mounted into mcp-cypher
# only for server-owned quality tools + coordinator API backend.
NEO4J_QUALITY_USERNAME=digital_brain_quality
NEO4J_QUALITY_PASSWORD=change-me-quality

# Authenticated local coordinator control API (non-MCP). Never give this to
# analyzer/evaluator agents.
DIGITAL_BRAIN_COORDINATOR_SECRET=change-me-coordinator

# Operator activation boundary (Alias/policy/overlay). Intentionally NOT used by
# model-facing MCP compose service — keep host-side only.
# NEO4J_OPERATOR_USERNAME=
# NEO4J_OPERATOR_PASSWORD=
# DIGITAL_BRAIN_OPERATOR_SECRET=

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=20
# Host-side tools use the published Ollama port. docker-compose.yml deliberately
# overrides this for mcp-cypher with http://ollama:11434 inside its network.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_EXTRAS=

# Docker Desktop must be allocated at least 6 GiB for the local stack. These
# Neo4j limits reserve headroom for Ollama's bge-m3 embeddings.
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_MAX_SIZE=1G
NEO4J_PAGECACHE_SIZE=512M

MCP_CYPHER_PORT=8000
MCP_MEMORY_PORT=8001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
