DIGITAL_BRAIN_MCP_URL=http://localhost:8000/api/mcp/

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=20
# Host-side tools use the published Ollama port. docker-compose.yml deliberately
# overrides this for mcp-cypher with http://ollama:11434 inside its network.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_EXTRAS=

# Docker Desktop must be allocated at least 6 GiB for the local stack. These
# Neo4j limits reserve headroom for Ollama's bge-m3 embeddings.
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_MAX_SIZE=1G
NEO4J_PAGECACHE_SIZE=512M

MCP_CYPHER_PORT=8000
MCP_MEMORY_PORT=8001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
