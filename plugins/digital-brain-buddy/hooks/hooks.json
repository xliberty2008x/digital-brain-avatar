{
  "description": "Bring up local Neo4j + Cypher MCP stack for the digital-brain-buddy plugin",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/compose-up.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
